# ============================================================
# DỰ ÁN: ComicHub
# FILE: .env.example
# PHỤ TRÁCH: TV1 (backend secrets/config); TV2 phối hợp với VITE_API_URL ở frontend/.env
# MỤC ĐÍCH: Mẫu biến môi trường để từng thành viên tự tạo file .env cục bộ.
# TRẠNG THÁI: MẪU ĐÃ CÓ; CẦN ĐIỀN GIÁ TRỊ CỤC BỘ VÀ KIỂM TRA CÁCH NẠP.
# LƯU Ý: Không điền credential/secret thật vào file mẫu hoặc commit file .env thật.
#        JWT_SECRET phải là giá trị bí mật đủ mạnh; DB_USERNAME/PASSWORD tùy máy.
# ============================================================
# ===== Database =====
DB_HOST=localhost
DB_PORT=1433
DB_NAME=comichub
DB_USERNAME=
DB_PASSWORD=

# ===== JWT =====
JWT_SECRET=
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# ===== CORS =====
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ===== Upload ảnh =====
UPLOAD_DIR=../uploads